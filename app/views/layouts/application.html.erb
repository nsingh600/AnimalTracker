<!DOCTYPE html>
<html>
  <head>
    <title>AnimalTracker</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  </head>

  <body>
    <nav class="navbar is-dark" role="navigation" aria-label="main navigation">
      <div class="container">
        <div class="navbar-brand">
          <a class="navbar-item font-weight-bold" href="/">🐾 BioTracker</a>
        </div>
        <div class="navbar-menu">
          <div class="navbar-start">
            <%= link_to 'All Species', species_index_path, class: 'navbar-item' %>
            <%= link_to 'Categories', categories_path, class: 'navbar-item' %>
            <%= link_to 'Habitats', habitats_path, class: 'navbar-item' %>
            <%= link_to 'About Data', about_path, class: 'navbar-item' %>
          </div>
        </div>
      </div>
    </nav>

    <section class="section">
      <div class="container">
        <%= yield %>
      </div>
    </section>
  </body>
</html>