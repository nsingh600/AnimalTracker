<section class="section">
  <div class="container">
    <h1 class="title">Habitats & Regions</h1>
    <p class="subtitle">Explore wildlife tracking data across different regions and climates.</p>

    <div class="columns is-multiline">
      <% @habitats.each do |habitat| %>
        <div class="column is-one-third">
          <div class="card">
            <div class="card-content">
              <p class="title is-4"><%= link_to habitat.region_name, habitat %></p>
              <p class="subtitle is-6">Climate: <span class="tag is-info"><%= habitat.climate %></span></p>
              <p class="text-muted"><small><%= habitat.species.count %> species found here</small></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>